# Copy to `.env` and fill in. Read by `node --env-file=.env` when the script
# starts.

# From sanity.io/manage.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# An API token with Editor permissions (or higher), created under API > Tokens
# on the project at sanity.io/manage. Comments are written as the token's user.
SANITY_API_TOKEN=

# An existing document to read and write comments on. The guide uses
# `post-123` of type `post`.
SANITY_DOCUMENT_ID=
SANITY_DOCUMENT_TYPE=post
