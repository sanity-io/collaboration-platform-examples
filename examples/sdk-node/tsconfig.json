{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // A Node script: no DOM, and `.ts` extensions in imports, which Node's
    // type stripping needs.
    "lib": ["ES2024"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
