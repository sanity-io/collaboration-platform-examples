# Copy to `.env` and fill in. Read at build time: restart `pnpm dev` after a
# change.

# From sanity.io/manage.
SANITY_APP_PROJECT_ID=
SANITY_APP_DATASET=production
SANITY_APP_ORGANIZATION_ID=

# An existing document to read and write comments on. The guides use
# `post-123` of type `post` (or `article`).
SANITY_APP_DOCUMENT_ID=
SANITY_APP_DOCUMENT_TYPE=post

# The field new threads start on, in "Write comments".
SANITY_APP_FIELD_PATH=title

# A Portable Text field on that document, for "Anchor inline comments".
SANITY_APP_PORTABLE_TEXT_PATH=body
