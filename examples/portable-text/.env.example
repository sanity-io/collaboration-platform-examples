# Copy to `.env` and fill in. Read at build time: restart `pnpm dev` after a
# change.

# From sanity.io/manage.
SANITY_APP_PROJECT_ID=
SANITY_APP_DATASET=production
SANITY_APP_ORGANIZATION_ID=

# An existing document to comment on. The guide uses `post-123` of type `post`.
SANITY_APP_DOCUMENT_ID=
SANITY_APP_DOCUMENT_TYPE=post

# A Portable Text field on that document, holding plain text blocks. The guide
# uses `body`.
SANITY_APP_PORTABLE_TEXT_PATH=body

# Optional, for the "Comment on a nested Portable Text field" pattern: a
# Portable Text array inside a block of that field, for example
# body[_key=="callout-1"].content
SANITY_APP_NESTED_PORTABLE_TEXT_PATH=
