# Copy to `.env` and fill in. Read at build time: restart `pnpm dev` after a
# change.

# From sanity.io/manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# An existing document to comment on. The guide uses `post-123` of type `post`.
NEXT_PUBLIC_SANITY_DOCUMENT_ID=
NEXT_PUBLIC_SANITY_DOCUMENT_TYPE=post
